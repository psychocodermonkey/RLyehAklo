{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "RLYEH_AKLO_BUILD_LINUX_KERNEL_MODULE": "ON"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Linux Kernel Module (Debug)",
      "inherits": "linux-base",
      "cacheVariables": {
        "RLYEH_AKLO_STRIP_LINUX_KERNEL_MODULE": "OFF"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Linux Kernel Module (Release)",
      "inherits": "linux-base",
      "cacheVariables": {
        "RLYEH_AKLO_STRIP_LINUX_KERNEL_MODULE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-linux",
      "configurePreset": "debug-linux"
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux"
    }
  ]
}
